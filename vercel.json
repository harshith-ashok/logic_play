{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/articles/images/:name", "destination": "/api/blog/image?name=:name" },
    { "source": "/blog/:slug", "destination": "/api/blog/page?slug=:slug" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
