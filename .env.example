# Copy to .env (local) and set the same names in Vercel:
# Project -> Settings -> Environment Variables (enable Production AND Preview).
# Real values never go in git; .env is gitignored.

# Supabase (public, safe to expose - bundled into the client)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Blog storage (SECRET - server-side only, never prefix with VITE_)
# Fine-grained token with Contents: read & write on the blog repo
GITHUB_TOKEN=<github-token>
BLOG_REPO=<owner>/<repo>
BLOG_BRANCH=main

# Optional: your custom domain, used for canonical/OG/robots.txt. Defaults to
# the Vercel production domain, then localhost.
# VITE_SITE_URL=https://example.com
